<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <Switch
        android:id="@+id/toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:text="DNS override"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="22sp" />

    <TextView
        android:id="@+id/status"
        style="@style/Helper"
        android:lineSpacingExtra="2sp"
        android:paddingBottom="4dp" />

    <LinearLayout style="@style/SectionRow">

        <TextView
            style="@style/Section"
            android:text="Upstream for other names" />
    </LinearLayout>

    <Spinner
        android:id="@+id/upstream"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:spinnerMode="dropdown" />

    <LinearLayout style="@style/SectionRow">

        <TextView
            style="@style/Section"
            android:text="Apps" />

        <Button
            android:id="@+id/appsBtn"
            style="@style/FlatButton"
            android:text="Choose apps" />
    </LinearLayout>

    <Spinner
        android:id="@+id/appMode"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:spinnerMode="dropdown" />

    <LinearLayout style="@style/SectionRow">

        <TextView
            style="@style/Section"
            android:text="Options" />

        <Button
            android:id="@+id/checkUpdate"
            style="@style/FlatButton"
            android:text="Check for updates" />
    </LinearLayout>

    <Switch
        android:id="@+id/notif"
        style="@style/RowSwitch"
        android:text="Status bar notification while on" />

    <Switch
        android:id="@+id/devChannel"
        style="@style/RowSwitch"
        android:text="Offer every main build (dev channel)" />

    <LinearLayout style="@style/SectionRow">

        <TextView
            style="@style/Section"
            android:text="Hosts" />

        <Button
            android:id="@+id/importBtn"
            style="@style/FlatButton"
            android:text="Import file" />
    </LinearLayout>

    <TextView
        style="@style/Helper"
        android:paddingBottom="8dp"
        android:text="One entry per line: IP, then one or more names. Edits apply live." />

    <EditText
        android:id="@+id/hosts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/box"
        android:fontFamily="monospace"
        android:gravity="top|start"
        android:hint="192.0.2.10  app.example.test"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textNoSuggestions"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:textSize="14sp" />
</LinearLayout>
